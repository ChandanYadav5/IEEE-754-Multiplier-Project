extern "C" int errors(int op1, int op2 ) {
    float ideal = *(float*)&op1;
    float actual = *(float*)&op2;
    float relative_error;
        // Calculate the relative error
          relative_error = fabs((ideal - actual) / ideal);
         // Check if the relative error exceeds the threshold
    if (relative_error > THRESHOLD) {
        printf("Relative error (%.10f) exceeds threshold (%.10f).\n", relative_error, THRESHOLD);
        
        return 1;
    } else {
